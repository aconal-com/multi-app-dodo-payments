# Environment
ENVIRONMENT=development
SERVICE_PORT=8001
LOG_LEVEL=INFO

# Dodo Payments (REPLACE WITH YOUR KEYS)
DODO_API_KEY=your-key
DODO_WEBHOOK_SECRET=webhook-secret
DODO_BASE_URL=https://test.dodopayments.com

# Database
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=dodo_payments_db
MYSQL_PORT=3306

# Security
API_KEY_ENCRYPTION_KEY=local_dev_encryption_key_min_32_characters
WEBHOOK_SIGNING_SECRET=webhook-signing-secret

# Features
ENABLE_REFUNDS=true
ENABLE_SUBSCRIPTIONS=true
ENABLE_ANALYTICS=true

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# CORS (add your frontend URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173


# 2. Configure .env
MIXPANEL_ENABLED=true
MIXPANEL_PROJECT_TOKEN=token
MIXPANEL_DATA_RESIDENCY=EU